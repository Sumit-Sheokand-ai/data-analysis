APP_ENV=development
DATA_SOURCE=csv
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?sslmode=require

# App auth
APP_REQUIRE_AUTH=0
APP_AUTH_MODE=disabled
APP_AUTH_DEFAULT_WORKSPACE=default
APP_AUTH_DEFAULT_ROLE=viewer
APP_AUTH_BASIC_USERS_JSON=
APP_WORKSPACE_PLAN_MAP_JSON=
APP_PUBLIC_BASE_URL=https://syntellia.ca
APP_CORS_ALLOWED_ORIGINS=https://syntellia.ca
APP_CORS_ALLOW_CREDENTIALS=1

# Frontend runtime (public values)
SUPABASE_URL=https://nureoptogfvxsbfwvvhy.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_1M50nK7fwxxfXVdgG2AhLw_RK58f3T6
FRONTEND_API_BASE_URL=https://api.syntellia.ca

# Service integration (app -> services)
APP_PIPELINE_SERVICE_URL=
APP_INSIGHTS_SERVICE_URL=
APP_POLICY_SERVICE_URL=
APP_SERVICE_AUTH_TOKEN=

# Service runtime auth (set in service environments)
SERVICE_API_AUTH_TOKEN=
SERVICE_HEALTH_REQUIRE_AUTH=0

# Production hardening
APP_DISABLE_LOCAL_STATE_FALLBACK=0
APP_DISABLE_LOCAL_PIPELINE_FALLBACK=0

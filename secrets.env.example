# Copy to `secrets.env` and replace placeholders before deployment.

# Supabase Postgres connection (prefer pooler URL for production)
DATABASE_URL=postgresql://<db_user>:<url_encoded_db_password>@<db_host>:<db_port>/<db_name>?sslmode=require

# App login users (single-line JSON)
APP_AUTH_BASIC_USERS_JSON={"admin":{"password":"<strong_password>","user_id":"admin","workspace_id":"default","role":"owner","plan_slug":"pro"}}

# Internal service auth tokens (if services are enabled)
APP_SERVICE_AUTH_TOKEN=<set_strong_random_token>
SERVICE_API_AUTH_TOKEN=<set_same_or_service_specific_token>

# Optional Supabase secret key (only if backend integrations need it)
SUPABASE_SERVICE_ROLE_KEY=<optional_service_role_key>
